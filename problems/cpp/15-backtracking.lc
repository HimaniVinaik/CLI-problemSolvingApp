4
> ["(((())))","((()()))","((())())","((()))()","(()(()))","(()()())","(()())()","(())(())","(())()()","()((()))","()(()())","()(())()","()()(())","()()()()"]

@@@ problem 79 word-search
title: Word Search
difficulty: Medium
topics: Array, String, Backtracking, Depth-First Search, Matrix
params: board, word
time: O(m · n · 3^L)
space: O(L)
stress: 20
bench: off

=== description
Given an `m x n` grid of characters `board` and a string `word`, return `true` if `word` exists in the grid.

The word is formed by letters of sequentially **adjacent** cells (horizontal or vertical neighbours). The same cell may not be used more than once.

Follow-up: could you use search pruning to make it faster on larger boards?

=== constraints
- `1 <= m, n <= 6`
- `1 <= word.length <= 15`
- `board` and `word` consist of English letters

=== hints
- DFS from every cell that matches `word[0]`.
- Mark cells on the current path (e.g. overwrite with `'#'`) and restore them when backtracking.
- Pruning: if the board doesn't contain enough of some letter, answer `false` immediately.

=== template
class Solution {
public:
    bool exist(vector<vector<char>>& board, string word) {

    }
};

=== driver
LC_DRIVER {
    h.solve(&Solution::exist);
    h.gen([](lc::Gen &g, int) {
        int r = g.irange(1, 5), c = g.irange(1, 5);
        std::vector<std::vector<char>> b(r, std::vector<char>(c));
        for (auto &row : b) for (auto &x : row) x = "ABCab"[g.irange(0, 4)];
        std::string w;
        if (g.coin(0.5)) {
            int y = g.irange(0, r - 1), x = g.irange(0, c - 1);
            std::set<std::pair<int, int>> used;
            for (int k = 0, len = g.irange(1, 8); k < len; ++k) {
                w += b[y][x];
                used.insert({y, x});
                std::vector<std::pair<int, int>> nb;
                for (auto [dy, dx] : std::vector<std::pair<int, int>>{{1, 0}, {-1, 0}, {0, 1}, {0, -1}}) {
                    int ny = y + dy, nx = x + dx;
                    if (ny >= 0 && ny < r && nx >= 0 && nx < c && !used.count({ny, nx})) nb.push_back({ny, nx});
                }
                if (nb.empty()) break;
                std::tie(y, x) = g.pick(nb);
            }
        } else {
            w = g.str(g.irange(1, 6), "ABCab");
        }
        return lc::lines(b, w);
    });
}

=== approach
Try every cell as a starting point and run a **backtracking DFS** that matches `word[i]` at cell `(r, c)`:

- out of bounds, or the letter differs: fail;
- the last letter matched: success;
- otherwise temporarily mark the cell (`'#'`) so the path can't reuse it, try the four neighbours for `word[i + 1]`, and restore the cell.

A cheap pruning step first compares letter counts: if the board lacks some letter the word needs, the answer is `false` without searching.

=== solution
class Solution {
    int m = 0, n = 0;

    bool dfs(vector<vector<char>> &b, const string &w, int r, int c, size_t i) {
        if (r < 0 || r >= m || c < 0 || c >= n || b[r][c] != w[i]) return false;
        if (i + 1 == w.size()) return true;          // matched the whole word
        char saved = b[r][c];
        b[r][c] = '#';                               // mark as used on this path
        bool found = dfs(b, w, r + 1, c, i + 1) || dfs(b, w, r - 1, c, i + 1) ||
                     dfs(b, w, r, c + 1, i + 1) || dfs(b, w, r, c - 1, i + 1);
        b[r][c] = saved;                             // backtrack
        return found;
    }

public:
    bool exist(vector<vector<char>>& board, string word) {
        m = board.size();
        n = board[0].size();
        // Pruning: the board must contain enough of every letter.
        int have[128] = {0}, need[128] = {0};
        for (auto &row : board) for (char ch : row) have[(unsigned char)ch]++;
        for (char ch : word) if (++need[(unsigned char)ch] > have[(unsigned char)ch]) return false;

        for (int r = 0; r < m; ++r)
            for (int c = 0; c < n; ++c)
                if (dfs(board, word, r, c, 0)) return true;
        return false;
    }
};

=== examples
[["A","B","C","E"],["S","F","C","S"],["A","D","E","E"]]
"ABCCED"
> true

[["A","B","C","E"],["S","F","C","S"],["A","D","E","E"]]
"SEE"
> true

[["A","B","C","E"],["S","F","C","S"],["A","D","E","E"]]
"ABCB"
> false
: The path would need to reuse the 'B' cell.

=== tests
[["a"]]
"a"
> true

[["a"]]
"b"
> false

[["a","a"]]
"aaa"
> false

[["C","A","A"],["A","A","A"],["B","C","D"]]
"AAB"
> true
